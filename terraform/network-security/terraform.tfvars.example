# Illustrative values ONLY. Copy to ignored terraform.tfvars and replace them.
# Use AWS_PROFILE=sbh-delta-security in the shell, not a hardcoded provider profile.
inspection_mode     = "enabled" # enabled -> bypass -> disabled; restore via bypass first.
central_account_id  = "111122223333"
inspection_vpc_cidr = "10.250.0.0/24"
inspection_azs = {
  apne2-az1 = {
    tgw_subnet_cidr      = "10.250.0.0/28"
    firewall_subnet_cidr = "10.250.0.16/28"
  }
  apne2-az2 = {
    tgw_subnet_cidr      = "10.250.0.32/28"
    firewall_subnet_cidr = "10.250.0.48/28"
  }
}

shared_account_ids = []
spoke_attachments  = {}
vpn_networks       = {}
vpn_peers          = {}
allowed_flows      = {}

# A NEW detector must first be prepared suspended with all optional features disabled.
# Review its API state, then use the default true for the separate activation plan.
# See RUNBOOK.md. Do not suspend an already active detector for routine updates.
guardduty_enabled                      = true
guardduty_finding_publishing_frequency = "SIX_HOURS"

# Forward only the enterprise GuardDuty log group. False keeps local event storage.
guardduty_findings_forwarding_enabled = true
guardduty_findings_destination_arn    = "arn:aws:logs:ap-northeast-2:616723161368:destination:delta-platform-logs"

# Forward the enterprise Network Firewall FLOW and ALERT groups. This does not
# restore the firewall when inspection_mode is disabled.
network_firewall_logs_forwarding_enabled = true
network_firewall_logs_destination_arn    = "arn:aws:logs:ap-northeast-2:616723161368:destination:delta-platform-logs"

