#!/usr/bin/python3
import base64,json,os,subprocess
from pathlib import Path
os.umask(0o022)
config=json.loads(base64.b64decode('${config}'))
subprocess.run(['useradd','--system','--home-dir','/opt/delta-sample','--shell','/usr/sbin/nologin','delta-sample'],check=False)
for directory in ['/opt/delta-sample/bin','/opt/delta-sample/releases','/etc/delta-sample']:
    Path(directory).mkdir(parents=True,exist_ok=True)
Path('/etc/delta-sample/runtime.json').write_text(json.dumps(config))
for name,content in [('runtime.py','${runtime}'),('install.py','${installer}')]:
    path=Path('/opt/delta-sample/bin')/name
    path.write_bytes(base64.b64decode(content));path.chmod(0o755)
unit='''[Unit]
Description=Delta sample application
After=network-online.target
Wants=network-online.target
[Service]
User=delta-sample
Group=delta-sample
WorkingDirectory=/opt/delta-sample/current
ExecStart=/usr/bin/python3 /opt/delta-sample/bin/runtime.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
[Install]
WantedBy=multi-user.target
'''
Path('/etc/systemd/system/delta-sample.service').write_text(unit)
if config['ROLE']=='backend':
    proxy='''[Unit]
Description=Application Cloud SQL PSC proxy
After=network-online.target
Wants=network-online.target
[Service]
User=delta-sample
Group=delta-sample
ExecStart=/opt/delta-sample/current/runtime/cloud-sql-proxy --psc --address 127.0.0.1 --port 5432 --structured-logs '''+config['CONNECTION']+'''
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
[Install]
WantedBy=multi-user.target
'''
    Path('/etc/systemd/system/delta-sql-proxy.service').write_text(proxy)
subprocess.run(['systemctl','daemon-reload'],check=True)
print('Delta ${role} bootstrap prepared; application activation follows release installation.')
