          "type": "string"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Checks",
          "type": "array"
        },
        "verified_controls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VerifiedControl"
          },
          "title": "Verified Controls",
          "type": "array"
        },
        "posture": {
          "anyOf": [
            {
              "$ref": "#/$defs/PostureResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mapping": {
          "anyOf": [
            {
              "$ref": "#/$defs/MappingResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "remediation": {
          "$ref": "#/$defs/Remediation",
          "default": {
            "spec_ops": [],
            "waf_rules": []
          }
        },
        "rule_candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuleCandidate"
          },
          "title": "Rule Candidates",
          "type": "array"
        },
        "meta": {
          "$ref": "#/$defs/Meta",
          "default": {
            "llm_used": false,
            "model": null,
            "prompt_version": null,
            "input_hash": null,
            "usage": {},
            "duration_ms": 0
          }
        },
        "execution_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "assessment_id",
        "kind",
        "verdict"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
