{
  "$defs": {
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "rule_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "explanation",
        "confidence",
        "evidence_ids"
      ],
      "title": "Hypothesis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "summary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "hypotheses": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "maxItems": 10,
      "title": "Hypotheses",
      "type": "array"
    },
    "next_checks": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Next Checks",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Case Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "status": {
      "enum": [
        "analyzed",
        "analysis_unavailable",
        "invalid_analysis"
      ],
      "title": "Status",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "requires_human": {
      "const": true,
      "default": true,
      "title": "Requires Human",
      "type": "boolean"
    }
  },
  "required": [
    "summary",
    "next_checks",
    "limitations",
    "case_id",
    "run_id",
    "input_hash",
    "status"
  ],
  "title": "DiagnosisReport",
  "type": "object"
}
