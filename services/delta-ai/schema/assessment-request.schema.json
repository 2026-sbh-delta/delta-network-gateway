{
  "$defs": {
    "AttackResult": {
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "environment": {
          "enum": [
            "aws",
            "gcp",
            "onprem"
          ],
          "title": "Environment",
          "type": "string"
        },
        "observed": {
          "enum": [
            "blocked",
            "allowed",
            "alert_only",
            "unknown"
          ],
          "title": "Observed",
          "type": "string"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        }
      },
      "required": [
        "scenario",
        "environment",
        "observed"
      ],
      "title": "AttackResult",
      "type": "object"
    },
    "ClusterCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "status": {
          "enum": [
            "fail",
            "false_positive"
          ],
          "title": "Status",
          "type": "string"
        },
        "verification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification"
        }
      },
      "required": [
        "check_id",
        "status"
      ],
      "title": "ClusterCheck",
      "type": "object"
    },
    "EnvInventory": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "aws",
            "gcp",
            "onprem"
          ],
          "title": "Provider",
          "type": "string"
        },
        "waf": {
          "$ref": "#/$defs/WafInventory",
          "default": {
            "enabled": null,
            "product": null,
            "mode": null,
            "rule_groups": null
          }
        },
        "identity": {
          "$ref": "#/$defs/IdentityInventory",
          "default": {
            "mechanism": null,
            "cloud_apis": [],
            "cross_cloud_access": null
          }
        },
        "secrets": {
          "$ref": "#/$defs/SecretsInventory",
          "default": {
            "source": null,
            "plaintext_env": []
          }
        },
        "logging": {
          "$ref": "#/$defs/LoggingInventory",
          "default": {
            "central": null,
            "destination": null
          }
        },
        "ingress": {
          "$ref": "#/$defs/IngressInventory",
          "default": {
            "tls": null
          }
        },
        "network": {
          "$ref": "#/$defs/NetworkInventory",
          "default": {
            "gateway": null,
            "inspected": null,
            "l7_visible": null,
            "gateway_addresses": [],
            "firewall_rules": null
          }
        }
      },
      "required": [
        "provider"
      ],
      "title": "EnvInventory",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "attack_results": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttackResult"
          },
          "title": "Attack Results",
          "type": "array"
        },
        "reachability": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReachabilityProbe"
          },
          "title": "Reachability",
          "type": "array"
        },
        "sarif": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sarif"
        },
        "code_files": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/Report"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_vulnerabilities": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PackageVulnerability"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Vulnerabilities"
        },
        "cluster_checks": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ClusterCheck"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cluster Checks"
        },
        "log_signals": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/LogSignal"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Signals"
        },
        "network_posture": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkPosture"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "FirewallRule": {
      "additionalProperties": false,
      "description": "위에서 아래로 평가되는 실효 룰 한 줄. 점검할 인터페이스의 룰만 보낸다.",
      "properties": {
        "interface": {
          "title": "Interface",
          "type": "string"
        },
        "action": {
          "enum": [
            "pass",
            "block"
          ],
          "title": "Action",
          "type": "string"
        },
        "protocol": {
          "default": "any",
          "title": "Protocol",
          "type": "string"
        },
        "source": {
          "default": "any",
          "title": "Source",
          "type": "string"
        },
        "destination": {
          "title": "Destination",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        }
      },
      "required": [
        "interface",
        "action",
        "destination"
      ],
      "title": "FirewallRule",
      "type": "object"
    },
    "IdentityInventory": {
      "additionalProperties": false,
      "properties": {
        "mechanism": {
          "anyOf": [
            {
              "enum": [
                "irsa",
                "pod_identity",
                "workload_identity",
                "static_key",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mechanism"
        },
        "cloud_apis": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Cloud Apis",
          "type": "array"
        },
        "cross_cloud_access": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cross Cloud Access"
        }
      },
      "title": "IdentityInventory",
      "type": "object"
    },
    "IngressInventory": {
      "additionalProperties": false,
      "properties": {
        "tls": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tls"
        }
      },
      "title": "IngressInventory",
      "type": "object"
    },
    "LogSignal": {
      "additionalProperties": false,
      "description": "원본 로그가 아니라 수집기가 센 신호다. samples 는 신뢰하지 않는 데이터로 다룬다.",
      "properties": {
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "signal": {
          "enum": [
            "firewall_block",
            "attack_request_allowed",
            "attack_request_blocked",
            "http_5xx"
          ],
          "title": "Signal",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "samples": {
          "default": [],
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Samples",
          "type": "array"
        }
      },
      "required": [
        "source",
        "signal",
        "count"
      ],
      "title": "LogSignal",
      "type": "object"
    },
    "LoggingInventory": {
      "additionalProperties": false,
      "properties": {
        "central": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Central"
        },
        "destination": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination"
        }
      },
      "title": "LoggingInventory",
      "type": "object"
    },
    "NetworkInventory": {
      "additionalProperties": false,
      "properties": {
        "gateway": {
          "anyOf": [
            {
              "enum": [
                "anf",
                "haproxy",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gateway"
        },
        "inspected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inspected"
        },
        "l7_visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "L7 Visible"
        },
        "gateway_addresses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Gateway Addresses",
          "type": "array"
        },
        "firewall_rules": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FirewallRule"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Firewall Rules"
        }
      },
      "title": "NetworkInventory",
      "type": "object"
    },
    "NetworkPosture": {
      "additionalProperties": false,
      "description": "격리 상태를 판정할 실측값. None 은 측정하지 못했다는 뜻이며 안전으로 읽지 않는다.",
      "properties": {
        "upstream_firewall": {
          "anyOf": [
            {
              "enum": [
                "managed",
                "unmanaged"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Firewall"
        },
        "node_public_ip": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Public Ip"
        },
        "host_firewall": {
          "anyOf": [
            {
              "enum": [
                "default_deny",
                "permissive"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host Firewall"
        },
        "exposed_ports": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposed Ports"
        },
        "network_probes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReachabilityProbe"
          },
          "title": "Network Probes",
          "type": "array"
        },
        "inbound_probes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReachabilityProbe"
          },
          "title": "Inbound Probes",
          "type": "array"
        },
        "cluster_probes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReachabilityProbe"
          },
          "title": "Cluster Probes",
          "type": "array"
        },
        "namespaces_without_policy": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespaces Without Policy"
        }
      },
      "title": "NetworkPosture",
      "type": "object"
    },
    "PackageVulnerability": {
      "additionalProperties": false,
      "description": "이미지의 패키지 하나에 묶은 취약점. 호출자가 CVE 단위 결과를 묶어서 보낸다.",
      "properties": {
        "image": {
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "package": {
          "minLength": 1,
          "title": "Package",
          "type": "string"
        },
        "installed_version": {
          "default": "",
          "title": "Installed Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "unknown"
          ],
          "title": "Severity",
          "type": "string"
        },
        "fixed_versions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fixed Versions",
          "type": "array"
        },
        "vulnerability_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Vulnerability Ids",
          "type": "array"
        }
      },
      "required": [
        "image",
        "package",
        "severity"
      ],
      "title": "PackageVulnerability",
      "type": "object"
    },
    "ReachabilityProbe": {
      "additionalProperties": false,
      "description": "실제 연결 시험 결과. 설정이 아니라 실측이다.",
      "properties": {
        "environment": {
          "enum": [
            "aws",
            "gcp",
            "onprem"
          ],
          "title": "Environment",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "expected": {
          "enum": [
            "open",
            "closed"
          ],
          "title": "Expected",
          "type": "string"
        },
        "observed": {
          "enum": [
            "open",
            "closed",
            "unknown"
          ],
          "title": "Observed",
          "type": "string"
        }
      },
      "required": [
        "environment",
        "source",
        "target",
        "port",
        "expected",
        "observed"
      ],
      "title": "ReachabilityProbe",
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ReportFinding"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "source",
        "findings"
      ],
      "title": "Report",
      "type": "object"
    },
    "ReportFinding": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "cwe": {
          "pattern": "^CWE-\\d+$",
          "title": "Cwe",
          "type": "string"
        },
        "severity": {
          "default": "high",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "vulnerable_snippet": {
          "default": "",
          "title": "Vulnerable Snippet",
          "type": "string"
        },
        "safe_snippet": {
          "default": "",
          "title": "Safe Snippet",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cwe"
      ],
      "title": "ReportFinding",
      "type": "object"
    },
    "SecretsInventory": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "enum": [
                "aws_secrets_manager",
                "gcp_secret_manager",
                "k8s_secret",
                "vault",
                "env_plaintext"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "plaintext_env": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Plaintext Env",
          "type": "array"
        }
      },
      "title": "SecretsInventory",
      "type": "object"
    },
    "ServiceRef": {
      "additionalProperties": false,
      "properties": {
        "service_id": {
          "minLength": 1,
          "title": "Service Id",
          "type": "string"
        },
        "repo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repo"
        },
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        }
      },
      "required": [
        "service_id"
      ],
      "title": "ServiceRef",
      "type": "object"
    },
    "WafInventory": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "product": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "block",
                "count"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "rule_groups": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Groups"
        }
      },
      "title": "WafInventory",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "migration_parity",
        "code_security",
        "feedback_ingest",
        "runtime_security"
      ],
      "title": "Kind",
      "type": "string"
    },
    "service": {
      "$ref": "#/$defs/ServiceRef"
    },
    "source_env": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvInventory"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "target_env": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvInventory"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "$ref": "#/$defs/Evidence",
      "default": {
        "attack_results": [],
        "reachability": [],
        "sarif": null,
        "code_files": {},
        "report": null,
        "image_vulnerabilities": null,
        "cluster_checks": null,
        "log_signals": null,
        "network_posture": null
      }
    }
  },
  "required": [
    "assessment_id",
    "kind",
    "service"
  ],
  "title": "AssessmentRequest",
  "type": "object"
}
