          "title": "Severity",
          "type": "string"
        },
        "status": {
          "enum": [
            "fail",
            "unknown",
            "dismissed"
          ],
          "title": "Status",
          "type": "string"
        },
        "autofix": {
          "enum": [
            "allowed",
            "forbidden"
          ],
          "title": "Autofix",
          "type": "string"
