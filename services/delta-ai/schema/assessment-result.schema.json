        "title": {
          "title": "Title",
          "type": "string"
        },
        "location": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Location",
          "type": "object"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        },
        "has_doc": {
          "default": false,
          "title": "Has Doc",
          "type": "boolean"
        },
        "why": {
          "default": "",
          "title": "Why",
          "type": "string"
        },
        "citations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "ops": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SpecOp"
          },
          "title": "Ops",
          "type": "array"
