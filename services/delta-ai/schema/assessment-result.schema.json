            "$ref": "#/$defs/WafRule"
          },
          "title": "Waf Rules",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "rule_id",
        "category",
        "severity",
        "status",
        "autofix",
        "title"
      ],
      "title": "Finding",
      "type": "object"
    },
    "MappingResult": {
      "additionalProperties": false,
      "properties": {
        "region": {
