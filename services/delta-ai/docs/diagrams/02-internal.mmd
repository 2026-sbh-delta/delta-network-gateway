    llm["llm.py<br/>Claude · 가짜 LLM"]:::ext
    knowledge ~~~ judge
    judge --> secrets
    secrets ~~~ llm
  end
  subgraph result["③ 판정과 저장"]
    direction TB
    verdict["verdict.py<br/>최종 판정"]:::built
    store["store.py<br/>규칙 후보 저장"]:::store
    verdict ~~~ store
  end
  service --> checks
  service --> ai
  service --> result

