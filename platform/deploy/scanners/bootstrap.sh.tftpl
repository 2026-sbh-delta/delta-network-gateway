#!/bin/bash
set -euo pipefail
for attempt in $(seq 1 60); do
  if dnf install -y docker nginx python3; then break; fi
  sleep 10
done
command -v docker
mkdir -p /etc/delta-platform-scanner /opt/delta /opt/delta-platform-scanner
chmod 700 /etc/delta-platform-scanner
for attempt in $(seq 1 120); do
  device=$(lsblk -ndo PATH,SERIAL | awk -v serial="${volume_serial}" '$2 == serial {print $1; exit}')
  if [ -n "$device" ]; then break; fi
  sleep 5
done
[ -b "$device" ]
if ! blkid "$device" >/dev/null 2>&1; then mkfs.xfs "$device"; fi
uuid=$(blkid -s UUID -o value "$device")
printf 'UUID=%s /opt/delta xfs defaults,nofail 0 2\n' "$uuid" >> /etc/fstab
mount /opt/delta
chown root:root /opt/delta
mkdir -p /etc/systemd/system/docker.service.d
printf '[Unit]\nRequiresMountsFor=/opt/delta\n' > /etc/systemd/system/docker.service.d/scanner-data.conf
systemctl daemon-reload
systemctl enable --now docker amazon-ssm-agent
printf 'ready\n' > /opt/delta-platform-scanner/bootstrap-ready
