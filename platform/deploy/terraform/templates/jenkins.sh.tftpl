#!/bin/bash
set -euo pipefail
for attempt in $(seq 1 60); do
  if dnf install -y docker python3 jq; then break; fi
  sleep 10
done
command -v docker
systemctl enable --now docker amazon-ssm-agent
mkdir -p /etc/delta-jenkins /opt/delta-jenkins /srv/delta-jenkins
chmod 700 /etc/delta-jenkins
volume_serial="${volume_serial}"
if [ -n "$volume_serial" ]; then
  for attempt in $(seq 1 120); do
    device=$(lsblk -ndo PATH,SERIAL | awk -v serial="$volume_serial" '$2 == serial {print $1; exit}')
    if [ -n "$device" ]; then break; fi
    sleep 5
  done
  [ -b "$device" ]
  if ! blkid "$device" >/dev/null 2>&1; then mkfs.xfs "$device"; fi
  uuid=$(blkid -s UUID -o value "$device")
  printf 'UUID=%s /srv/delta-jenkins xfs defaults,nofail 0 2\n' "$uuid" >> /etc/fstab
  mount /srv/delta-jenkins
  chown 1000:1000 /srv/delta-jenkins
fi
printf 'ready\n' > /opt/delta-jenkins/bootstrap-ready
