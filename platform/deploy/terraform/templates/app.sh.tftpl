#!/bin/bash
set -euo pipefail
for attempt in $(seq 1 60); do
  if dnf install -y docker python3 jq; then break; fi
  sleep 10
done
command -v docker
systemctl enable --now docker amazon-ssm-agent
mkdir -p /usr/local/lib/docker/cli-plugins
curl --fail --location --retry 8 https://github.com/docker/compose/releases/download/v5.7.0/docker-compose-linux-aarch64 -o /usr/local/lib/docker/cli-plugins/docker-compose
printf '15861535d14e26555736b49376c95e14bfd94285366c8446bfac7156a972e76f  /usr/local/lib/docker/cli-plugins/docker-compose\n' | sha256sum -c -
chmod 755 /usr/local/lib/docker/cli-plugins/docker-compose
volume_serial="${replace(volume_id, "-", "")}"
for attempt in $(seq 1 120); do
  device=$(lsblk -ndo PATH,SERIAL | awk -v serial="$volume_serial" '$2 == serial {print $1; exit}')
  if [ -n "$device" ]; then break; fi
  sleep 5
done
[ -b "$device" ]
if ! blkid "$device" >/dev/null 2>&1; then mkfs.xfs "$device"; fi
mkdir -p /srv/delta-platform /etc/delta-platform /opt/delta-platform
uuid=$(blkid -s UUID -o value "$device")
printf 'UUID=%s /srv/delta-platform xfs defaults,nofail 0 2\n' "$uuid" >> /etc/fstab
mount /srv/delta-platform
chmod 700 /etc/delta-platform
printf 'ready\n' > /opt/delta-platform/bootstrap-ready
