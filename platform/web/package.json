{
  "name": "delta-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:production": "vite --host 127.0.0.1 --mode production-ui",
    "build": "tsc --noEmit && vite build",
    "build:production": "tsc --noEmit && vite build --config vite.production.config.ts && node scripts/production-ui.mjs build",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src vite.config.ts playwright.config.ts tests"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
