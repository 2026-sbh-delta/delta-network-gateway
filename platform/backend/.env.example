# platform-init 명령이 실제 로컬 설정을 생성합니다. 이 파일에는 비밀값을 넣지 않습니다.
PLATFORM_DATABASE_URL=postgresql+psycopg://platform:REPLACE@127.0.0.1:55432/platform
PLATFORM_LOGIN_ID=REPLACE
PLATFORM_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_HASH
PLATFORM_PUBLIC_ORIGIN=http://127.0.0.1:8088
PLATFORM_LOCAL_MODE=true
# 고객 이미지 빌드: Jenkins가 기본입니다. 토큰은 실제 ignored .env/SSM에만 저장합니다.
PLATFORM_BUILD_PROVIDER=jenkins
PLATFORM_JENKINS_URL=http://127.0.0.1:18081
PLATFORM_JENKINS_JOB=delta-platform-image
PLATFORM_JENKINS_USER=platform
PLATFORM_JENKINS_TOKEN=REPLACE_WITH_API_TOKEN
# 사설 인증서 사용 시 CA PEM의 base64. 공개 CA를 쓰면 빈 값.
PLATFORM_JENKINS_CA_BASE64=
PLATFORM_BUILD_REPOSITORY=REPLACE_WITH_ECR_REPOSITORY_URI
PLATFORM_BUILD_REGION=ap-northeast-2
# 기존 SAST 서비스 연결. 비워 두면 새 검사 요청만 503으로 차단합니다.
PLATFORM_SAST_URL=
PLATFORM_SAST_TOKEN=
