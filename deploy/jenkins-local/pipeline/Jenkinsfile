// 스캔 → AI 판단 → 카나리 → 승격 또는 자동 롤백.
// 판단 서비스는 판정만 내고, 실행은 이 파이프라인이 한다 (ADR-AI-05).
// 기준을 넘은 지표의 롤백은 판단 응답을 기다리지 않는다. 승격은 pass 를 받아야만 한다.

def scripts() { return '/pipelines/pipeline/scripts' }

def logged(String stage, String command) {
    env.CURRENT_STAGE = stage
    sh "#!/bin/bash\n${scripts()}/run_logged.sh ${stage} ${command}"
}

def gate(String args) {
    return sh(returnStatus: true, script: "python3 ${scripts()}/gate.py ${args}")
}

def humanGate(String message) {
    timeout(time: 10, unit: 'MINUTES') {
        input id: 'HumanGate', message: message
    }
}

def setSplit(String stable, String canary, int percent) {
    sh "python3 ${scripts()}/haproxy_ctl.py split --stable ${stable} --canary ${canary} --percent ${percent}"
}

// 새 슬롯으로 가는 트래픽을 끊고 컨테이너를 지운다. 여러 번 불려도 안전하다.
def rollback() {
    if (env.ROLLOUT_ACTIVE != 'true') {
        return
    }
    if (env.STABLE_SLOT) {
        setSplit(env.STABLE_SLOT, env.CANARY_SLOT, 0)
    }
    sh "docker rm -f demo-${env.CANARY_SLOT} >/dev/null 2>&1 || true"
    env.ROLLOUT_ACTIVE = 'false'
    echo "롤백 완료: 안정 슬롯=${env.STABLE_SLOT ?: '없음'}"
}

def judgeSecurity() {
    int code = gate("code_security --id build-${BUILD_NUMBER}-sast --sarif sast.sarif --code-root app --out sast-result.json")
    if (code == 0) {
        return
    }
    env.GATE_ALREADY_REPORTED = 'true'  // 판정이 곧 중단 사유다. 단계 실패로 다시 분석하지 않는다
    if (code == 10) {
        error('판단 결과 fix: sast-result.json 의 수정안을 샌드박스에 적용하고 다시 실행한다')
    }
    if (code == 20) {
        humanGate('보안 판단이 사람 확인을 요구한다. sast-result.json 을 보고 진행 여부를 정한다')
        env.GATE_ALREADY_REPORTED = 'false'
        return
    }
    error('판단 서비스 응답 없음: 통과로 보지 않는다')
}

def promoteStep(int percent) {
    if (env.STABLE_SLOT) {
        setSplit(env.STABLE_SLOT, env.CANARY_SLOT, percent)
    }
    int status = sh(returnStatus: true, script: "#!/bin/bash\n${scripts()}/run_logged.sh traffic-${percent} python3 ${scripts()}/traffic.py --url http://haproxy/api/hello --version ${BUILD_NUMBER} --requests ${env.TRAFFIC_REQUESTS} --out metrics-${percent}.json")
    env.CURRENT_STAGE = "traffic-${percent}"
    if (status == 3) {
        rollback()
        error("트래픽 ${percent}% 에서 지표 기준 초과: 자동 롤백했다")
    }
    if (status != 0) {
        rollback()
        error("트래픽 ${percent}% 측정 실패: 롤백했다")
    }
    int code = gate("deployment_gate --id build-${BUILD_NUMBER}-traffic-${percent} --stage traffic-${percent} --target aws --traffic ${percent} --metrics metrics-${percent}.json --out gate-${percent}.json")
    if (code == 20) {
        humanGate("트래픽 ${percent}% 판단이 사람 확인을 요구한다. gate-${percent}.json 을 본다")
    } else if (code != 0) {
        env.GATE_ALREADY_REPORTED = 'true'
        rollback()
        error("트래픽 ${percent}% 판단을 통과하지 못했다(code=${code}): 롤백했다")
    }
}

pipeline {
    agent any
    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    parameters {
        choice(name: 'SCENARIO', choices: ['good', 'vulnerable-code', 'failing-test', 'bad-canary', 'gate-down', 'low-traffic'],
               description: '시험할 상황')
    }
    environment {
        DELTA_API_TOKEN = credentials('delta-api-token')
        DELTA_URL = "${params.SCENARIO == 'gate-down' ? 'http://delta-ai:1' : 'http://delta-ai:8090'}"
        CANARY_FAIL_RATE = "${params.SCENARIO == 'bad-canary' ? '0.5' : '0'}"
        // 10% 단계의 표본이 판단 최소치(20건)에 못 미치게 해 사람 확인 경로를 시험한다
        TRAFFIC_REQUESTS = "${params.SCENARIO == 'low-traffic' ? '100' : '400'}"
        DOCKER_BUILDKIT = '0'
    }
    stages {
        stage('준비') {
            steps {
                deleteDir()
                sh '''
                    cp -r /pipelines/demo-app app
                    mv app/scenarios scenarios
                '''
                script {
                    if (params.SCENARIO == 'vulnerable-code') {
                        sh 'cp scenarios/vulnerable.py app/'
                    }
                    if (params.SCENARIO == 'failing-test') {
                        sh 'cp scenarios/test_broken.py app/'
                    }
                }
            }
        }
        stage('테스트') {
            steps {
                script { logged('test', 'python3 -m unittest discover -s app -v') }
            }
        }
        stage('SAST·보안 판단') {
            steps {
                script {
                    logged('sast', 'semgrep scan --config app/.semgrep.yml --sarif --output sast.sarif --metrics=off --disable-version-check app')
                    judgeSecurity()
                }
            }
        }
        stage('이미지 빌드') {
            steps {
                script { logged('build', "docker build -q -t delta-demo:${BUILD_NUMBER} app") }
            }
        }
        stage('새 슬롯 배포') {
            steps {
                script {
                    String active = sh(returnStdout: true, script: "python3 ${scripts()}/haproxy_ctl.py active").trim()
                    boolean running = sh(returnStatus: true, script: "docker ps --format '{{.Names}}' | grep -qx demo-${active}") == 0
                    env.STABLE_SLOT = running ? active : ''
                    env.CANARY_SLOT = running ? (active == 'blue' ? 'green' : 'blue') : active
                    env.ROLLOUT_ACTIVE = 'true'
                    logged('deploy', """bash -c 'docker rm -f demo-${env.CANARY_SLOT} >/dev/null 2>&1; docker run -d --name demo-${env.CANARY_SLOT} --network delta-local --label delta.build=${BUILD_NUMBER} -e APP_VERSION=${BUILD_NUMBER} -e FAIL_RATE=${env.CANARY_FAIL_RATE} delta-demo:${BUILD_NUMBER}'""")
                    logged('smoke', "python3 ${scripts()}/haproxy_ctl.py wait-up --slot ${env.CANARY_SLOT}")
                }
            }
        }
        stage('단계적 전환') {
            steps {
                script {
                    // 안정 슬롯이 없는 첫 배포는 나눌 트래픽이 없다
                    List steps = env.STABLE_SLOT ? [10, 50, 100] : [100]
                    for (int percent in steps) {
                        promoteStep(percent)
                    }
                }
            }
        }
        stage('승격 완료') {
            steps {
                script {
                    if (env.STABLE_SLOT) {
                        // 처리 중인 요청을 끊지 않도록 SIGTERM 으로 끝낸다
                        sh "docker stop -t 5 demo-${env.STABLE_SLOT} >/dev/null && docker rm demo-${env.STABLE_SLOT} >/dev/null"
                    }
                    env.ROLLOUT_ACTIVE = 'false'
                    echo "운영 슬롯=${env.CANARY_SLOT} 버전=${BUILD_NUMBER}"
                }
            }
        }
    }
    // Declarative post 는 always → failure → cleanup 순서로 돈다.
    // 롤백이 분석보다 먼저여야 해서 always 에 두고, 산출물은 분석 결과까지 담도록 cleanup 에서 올린다.
    post {
        always {
            script {
                if (currentBuild.currentResult != 'SUCCESS') {
                    rollback()
                }
            }
        }
        failure {
            script {
                // 원인 분석은 롤백 뒤에 한다. 판단 서비스가 죽어 있어도 빌드 결과는 이미 실패다.
                if (env.GATE_ALREADY_REPORTED == 'true') {
                    return
                }
                String stage = env.CURRENT_STAGE ?: 'unknown'
                String exitFile = "logs/${stage}.exit"
                String exitArg = fileExists(exitFile) ? "--exit-code ${readFile(exitFile).trim()}" : ''
                String metricsFile = stage.startsWith('traffic-') ? "metrics-${stage.substring(8)}.json" : ''
                String metricsArg = metricsFile && fileExists(metricsFile) ? "--metrics ${metricsFile}" : ''
                gate("deployment_gate --id build-${BUILD_NUMBER}-failure --stage ${stage} --status failed --target aws ${exitArg} ${metricsArg} --log logs/${stage}.log --out failure-analysis.json")
            }
        }
        cleanup {
            archiveArtifacts artifacts: 'logs/**, *.json, *.sarif, events.jsonl', allowEmptyArchive: true
        }
    }
}
