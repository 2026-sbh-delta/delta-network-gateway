// 신뢰된 배포 실행기에서만 승인·Terraform·앱 배포를 처리한다.
pipeline {
  agent { label 'delta-deploy' }
  options { timestamps(); timeout(time: 60, unit: 'MINUTES'); disableConcurrentBuilds() }
  stages {
    stage('운영 승인·배포·실행 조회') {
      when { expression { env.JOB_NAME != 'delta-mapped-release' } }
      steps {
        sh 'rm -f result.json && python3 /opt/delta/release_deploy.py'
      }
    }
    stage('차분 기반 Terraform Plan') {
      when { expression { env.JOB_NAME == 'delta-mapped-release' } }
      steps {
        sh 'rm -rf -- .mapped-terraform && rm -f -- result.json terraform-plan.json'
        sh 'python3 /opt/delta/release_deploy.py plan'
        archiveArtifacts artifacts: 'terraform-plan.json', fingerprint: false
      }
    }
    stage('Terraform 승인·적용·앱 배포') {
      when { expression { env.JOB_NAME == 'delta-mapped-release' } }
      steps {
        script {
          String digest = readFile('.mapped-terraform/plan.sha256').trim()
          timeout(time: 15, unit: 'MINUTES') {
            input id: 'terraform-plan', message: readFile('terraform-plan.json'),
                  submitter: 'admin', ok: '이 Plan 적용 및 앱 배포'
          }
          withEnv(["DELTA_APPROVED_PLAN_SHA256=${digest}"]) {
            sh 'python3 /opt/delta/release_deploy.py apply'
          }
        }
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'result.json', allowEmptyArchive: true, fingerprint: false
    }
    cleanup { sh 'rm -rf -- .mapped-terraform' }
  }
}
