// 앱 저장소를 실행하지 않는 배포 전용 경로. 서명과 서버 인벤토리는 신뢰된 Python에서 확인한다.
// 컨트롤러 내장 노드(delta-deploy, 실행기 1개)에서만 돈다. 배포는 /opt/delta/release(동규님 방식 VM 배포기)가 맡는다.
pipeline {
  agent { label 'delta-deploy' }
  // 새 VM·DB 서버(Terraform) 생성과 Compose 기동을 기다린다. 같은 대상은 한 번에 하나만 배포한다.
  options { timestamps(); timeout(time: 60, unit: 'MINUTES'); disableConcurrentBuilds() }
  stages {
    stage('운영 승인·배포·실행 조회') {
      steps {
        sh 'rm -f result.json && python3 /opt/delta/release_deploy.py'
      }
    }
  }
  post {
    always { archiveArtifacts artifacts: 'result.json', allowEmptyArchive: true, fingerprint: false }
  }
}
